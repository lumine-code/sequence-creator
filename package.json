{
  "name": "sequence-creator",
  "author": "lumine-code",
  "description": "Generate sequences of numbers or characters across multiple cursors.",
  "repository": "https://github.com/lumine-code/sequence-creator",
  "bugs": {
    "url": "https://github.com/lumine-code/sequence-creator/issues"
  },
  "keywords": [
    "increment",
    "counter",
    "number",
    "multi-cursor",
    "generate",
    "enumerate"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "simulateCursorLength": {
      "title": "Maximum preview items",
      "description": "The maximum count of cursor items shown in the preview.",
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 7
    },
    "alphabetSequence": {
      "title": "Alphabet sequence",
      "description": "A series of letters used to generate a character sequence.",
      "type": "string",
      "default": "abcdefghijklmnopqrstuvwxyz"
    }
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
